# Copy this file to ".env" and fill in the two values from your Supabase project
# (Project Settings > API Keys, or the "Connect" button).
# Use the PUBLISHABLE key (starts with sb_publishable_) or the legacy "anon" key.
# NEVER put a "secret" or "service_role" key here – this file ends up in the public website.
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
